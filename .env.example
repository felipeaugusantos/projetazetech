# Copie os nomes abaixo para as variáveis/segredos do ambiente (Lovable Cloud → Secrets).
# Não coloque valores reais neste arquivo.

# E-mails ao cliente (migração 0030, src/lib/email)
RESEND_API_KEY=
EMAIL_FROM="Projeta <avisos@seudominio.com.br>"
EMAIL_REPLY_TO=
# Endereço público do app, usado nos links dos e-mails (padrão: origem da requisição de envio)
APP_URL=https://seu-app.lovable.app
# Segredo do agendamento do envio (crie um valor aleatório longo, ex.: `openssl rand -hex 32`) e use o
# MESMO valor em: select public.email_agendar_envio('https://seu-app.lovable.app/api/public/hooks/enviar-emails', '<valor>');
# Alternativa ao LOVABLE_CRON_SECRET, cujo valor o Lovable não exibe.
EMAIL_CRON_SECRET=
